# ---- Supabase (server-side, server-only) ----
# Used by `lib/supabase/server.ts` (supabaseAdmin) and
# `scripts/migrate.mjs`. Bypasses RLS — never expose to the browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ---- Supabase (browser-safe) ----
# Prefixed NEXT_PUBLIC_ so the values ship in the client bundle.
# Used by `lib/supabase/client.ts` (supabaseBrowser) and the server
# `getServerClient()` to verify the same anon key on both sides.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ---- App ----
# Origin used for OAuth redirects. Vercel: set to your production
# URL once deployed. Local dev: http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Migrations (scripts/migrate.mjs only) ----
# Direct postgres connection string. Find it under Supabase
# Dashboard → Project → Settings → Database → Connection string
# (use the "Transaction" pooler for serverless).
DATABASE_URL=postgres://postgres:<password>@<host>:5432/postgres

# ---- Where to set them ----
# Local:  copy this file to `.env` and fill in the values.
# Vercel: Project → Settings → Environment Variables. Add at minimum
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_ANON_KEY for the Production environment.
